# Copier ce fichier en .env et renseigner les valeurs réelles.
# Le .env n'est JAMAIS commité (voir .gitignore).

# ── Serveur ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ── Groq : génération des réponses + réécriture des requêtes ───────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cohere : embeddings multilingues + rerank ──────────────────────────────
# https://dashboard.cohere.com/api-keys
# Sans cette clé, le chatbot fonctionne encore mais en recherche lexicale seule.
COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Optionnel ──────────────────────────────────────────────────────────────
# Origines CORS supplémentaires (séparées par des virgules).
# localhost, *.netlify.app et *.onrender.com sont déjà autorisés.
# ALLOWED_ORIGINS=https://mon-domaine.com

# Quotas par IP (voir la note NAT dans le README)
# RATE_LIMIT_MAX=30
# RATE_LIMIT_LONG_MAX=10

# Mettre à 1 si le DNS de la plateforme résout déjà les enregistrements SRV
# SKIP_PUBLIC_DNS=1
